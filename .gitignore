# --- Python / OS / build junk ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
.env
.DS_Store
.ipynb_checkpoints/
bsim4.out

# --- Locally generated presentation decks (not shipped) ---
slides/
*.pptx

# --- Raw + heavy processed data (regenerate with scripts/setup_data.py) ---
data/raw/
data/processed/pdk_synth/*.npz
data/processed/pdk_synth_full*/
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/processed/pdk_synth/.gitkeep

# --- Figures: commit all PNGs (the README embeds them); skip heavy PDFs ---
figs/*.pdf

# --- out/: keep only the human-readable result tables and the final exported
#     card. Everything else (per-device sim data .npz, model checkpoints .pt,
#     and intermediate/experimental runs) is regenerable via the documented
#     pipeline, so it stays out of the repo. ---
out/*
!out/.gitkeep
!out/tables/
out/tables/*
!out/tables/.gitkeep
!out/tables/*.md
!out/tables/*.json
!out/tables/*.csv
!out/pdk_ml_selected/
out/pdk_ml_selected/*
!out/pdk_ml_selected/cards/
out/pdk_ml_selected/cards/*
!out/pdk_ml_selected/cards/*.spice
!out/pdk_ml_selected/cards/manifest.json

# --- Research-loop banks and bulky outputs (regenerable via scripts/research) ---
data/processed/cold_loop/
data/processed/temp_bank/
data/processed/pdk2/
# Results reports (PNG figures + tables) are kept for later reference.
!out/research/
out/research/*
!out/research/report/
# Local paper build files and archives are not versioned.
paper/
!out/research/tree/
!out/research/pdk2/
out/research/pdk2/*
!out/research/pdk2/floors/
!out/research/site/
!out/research/explore/
out/research/explore/**/*.npz
out/research/explore/**/*.pt
out/research/explore/I10_1/work/

# --- Downloaded external data (untrusted, not committed) ---
data/external/
# I3-2 follow-up: compiled OSDI binaries and their build stamps
out/research/explore/**/osdi/
out/research/explore/I20_1/**/cache/
out/research/explore/I23_1/**/cache/
