    k13 = tanh(1.5961058962e-01 + -1.6183789943e-01 * h0 + 3.5030508327e-02 * h1 + -8.3337917216e-02 * h2 + -8.0646210964e-02 * h3 + 1.0821645056e-01 * h4 + -1.4630883741e-01 * h5 + -1.5617844627e-01 * h6 + -2.5290754049e-01 * h7 + 3.8376286331e-02 * h8 + -2.4755254390e-01 * h9 + -1.1430797654e-01 * h10 + 2.8057932344e-01 * h11 + -3.2203871042e-02 * h12 + -1.1793093760e-01 * h13 + 4.8034406053e-03 * h14 + -1.5228017957e-02 * h15);
