    k13 = tanh(1.4834714711e-01 + -1.0473259797e-01 * h0 + 4.3470998536e-02 * h1 + -1.7381845409e-01 * h2 + -1.4136059812e-01 * h3 + 2.3610676348e-01 * h4 + -7.2461313832e-02 * h5 + 1.6033392385e-01 * h6 + 2.1914920288e-01 * h7 + -2.7056301511e-02 * h8 + -3.6877992108e-02 * h9 + -1.2678953801e-01 * h10 + 9.3831081249e-02 * h11 + 7.7005295796e-03 * h12 + 1.0950968769e-01 * h13 + -8.0126790009e-02 * h14 + 8.0780445089e-02 * h15);
