    k13 = tanh(1.1089991013e-01 + -7.9263674603e-02 * h0 + 7.7137105253e-03 * h1 + -7.2806734490e-02 * h2 + -5.4503019531e-02 * h3 + 4.4143095131e-02 * h4 + -3.0373921484e-02 * h5 + -6.6301328387e-03 * h6 + -1.0830822214e-01 * h7 + 1.5979679738e-03 * h8 + -1.1729515840e-01 * h9 + -8.4411450594e-02 * h10 + 1.6499741875e-01 * h11 + -1.1277951695e-02 * h12 + 1.2976213501e-03 * h13 + 8.9133455080e-03 * h14 + -3.7788756773e-03 * h15);
