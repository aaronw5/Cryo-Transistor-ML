    k13 = tanh(1.2853636695e-01 + -4.5283470974e-02 * h0 + 4.6005496754e-02 * h1 + -1.3277388904e-01 * h2 + -5.9200005355e-02 * h3 + 1.6230363877e-01 * h4 + -3.9648412901e-02 * h5 + 7.0533479499e-02 * h6 + 1.1957930426e-01 * h7 + -1.2032687626e-03 * h8 + -2.9975869540e-02 * h9 + -4.9954414221e-02 * h10 + 6.3070710173e-02 * h11 + 5.8134665821e-03 * h12 + 4.8987288393e-02 * h13 + -5.2093743513e-02 * h14 + 2.4754391033e-02 * h15);
