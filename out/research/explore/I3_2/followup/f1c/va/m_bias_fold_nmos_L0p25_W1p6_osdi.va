    h1 = tanh(1.3221225364e-01 + -2.3716137363e-01 * x0 + -1.0624110609e-01 * x1 + 1.7054322222e-02 * x2);
    h2 = tanh(4.8146306745e-01 + 7.0721676907e-01 * x0 + 4.2045515323e-02 * x1 + 4.5829746108e-01 * x2);
