    k13 = tanh(1.0172841121e-01 + 5.5756866362e-03 * h0 + 1.1038428354e-03 * h1 + -3.1031553693e-02 * h2 + -4.4587225180e-03 * h3 + 1.7313898482e-02 * h4 + -5.3919967052e-03 * h5 + -5.2461837639e-03 * h6 + -5.9592378545e-03 * h7 + -1.0133203380e-02 * h8 + 3.3119160446e-03 * h9 + 2.7513112517e-03 * h10 + 3.7410589749e-02 * h11 + -6.0648056466e-03 * h12 + -5.6136604852e-03 * h13 + 5.6158854018e-03 * h14 + -5.0530830791e-03 * h15);
