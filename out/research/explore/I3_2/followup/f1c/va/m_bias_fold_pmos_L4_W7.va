`include "disciplines.vams"
`include "constants.vams"
// I3-2 multiplicative correction (M_bias), 5-member 3-16-...-1 tanh MLP ensemble.
// I(d->s) total = I_sim * exp(g); g = mean over members of tanh(h(x)),
// x = standardized [pmos, abs(V(g, s)) / VDD, abs(V(d, s)) / VDD].
// abs() maps pMOS and nMOS forward bias to the same range; reverse-mode
// bias (Vds of the opposite sign) is folded onto forward mode.
module i3_2_bias_corr(d, g, s, di);
  inout d, g, s, di;
  electrical d, g, s, di;
  branch (d, di) sense;   // I(sense) = drain current into the compact model
  parameter real L = 1.0;   // um
  parameter real W = 1.0;   // um
  parameter real pmos = 0;  // 0 nMOS, 1 pMOS
  parameter real VDD = 1.85;
  real ib, gsum, acc, x0, x1, x2;
  real h0, h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11, h12, h13, h14, h15;
  real k0, k1, k2, k3, k4, k5, k6, k7, k8, k9, k10, k11, k12, k13, k14, k15;
  analog begin
    V(sense) <+ 0.0;
    ib = I(sense);
    x0 = (pmos - 0.0000000000e+00) / 1.0000000000e+00;
    x1 = (abs(V(g, s)) / VDD - 6.8075435590e-01) / 2.3472914874e-01;
    x2 = (abs(V(d, s)) / VDD - 5.1706121313e-01) / 3.1683133612e-01;
