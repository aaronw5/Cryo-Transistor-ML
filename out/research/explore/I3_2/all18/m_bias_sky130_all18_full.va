    k13 = tanh(1.5622276664e-01 + -1.5187828976e-01 * h0 + 2.9089126958e-02 * h1 + -7.9583908559e-02 * h2 + -7.9778323010e-02 * h3 + 1.0660254336e-01 * h4 + -1.4125323387e-01 * h5 + -1.5271057371e-01 * h6 + -2.3086795228e-01 * h7 + 2.9119189058e-02 * h8 + -2.3296492133e-01 * h9 + -1.0238400443e-01 * h10 + 2.6745238975e-01 * h11 + 9.9611016949e-03 * h12 + -8.2664675254e-02 * h13 + 1.7131548123e-03 * h14 + -1.3162855599e-02 * h15);
